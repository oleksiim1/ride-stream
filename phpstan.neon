includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5

    paths:
        - app
        - bootstrap/app.php
        - config
        - Modules
        - database
        - routes

    excludePaths:
        - Modules/*/tests/*

    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: Modules/*/config/*

    tmpDir: storage/framework/cache/phpstan
